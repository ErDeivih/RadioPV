# Build de producción: la web y la API se sirven por el MISMO origen.
# nginx proxya /api/ al contenedor de la API (ver deploy/nginx.conf).
#
# Tiene que ser relativo a propósito: así la app funciona desde cualquier máquina
# (el PC, el móvil por Tailscale, la IP de la LAN) sin recompilar y sin CORS.
#
# Si aquí se pone una URL absoluta tipo http://127.0.0.1:8000, el navegador de quien
# abra la web llamará a SU propia máquina y todo fallará en silencio.
VITE_API_URL=/api
VITE_APP_NAME=RadioNano
